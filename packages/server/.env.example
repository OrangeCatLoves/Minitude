# Copy this file to .env (same folder) and fill it in. .env is git-ignored: never commit it.
# Get a key at https://aistudio.google.com/apikey
# On Fly.io the key is a secret (`fly secrets set GEMINI_API_KEY=...`), not a file: see docs/DEPLOY.md

GEMINI_API_KEY=
# LLM_PROVIDER=gemini        # or "mock" to run without the model (only stored answers count)
# LLM_MODEL=gemini-3.8-flash # check the exact name in Google AI Studio
# LLM_MAX_PER_MINUTE=10      # calls beyond these limits are refused, not sent: keep them under your plan's limits
# LLM_MAX_PER_DAY=200
# DATABASE_FILE=             # default: packages/server/data/minitude.db
# PORT=8787

# Daily challenge and hosting (all optional)
# DAILY_PER_IP=10            # daily runs per network per day; 0 = no limit (the local machine is never limited)
# CLIENT_IP_HEADER=          # header that carries the visitor's address behind a proxy; Fly.io: fly-client-ip. Empty = the connection itself
# BACKUP_DIR=                # a copy of the database every UTC day goes here (minitude-YYYY-MM-DD.db); empty = no copies
# BACKUP_KEEP=7              # how many daily copies to keep
